{
  "name": "labhub-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "GITHUB_PAGES=true VITE_DEMO_MODE=true vite build --outDir dist-demo",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo --base /lab-orbit/ --port 4173",
    "pages:dev": "wrangler pages dev ./dist",
    "pages:deploy": "wrangler pages deploy ./dist --project-name=lab-hub-preview"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.15.0",
    "hono": "^4.13.7",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "three": "^0.186.0",
    "utif": "^3.1.0",
    "vanta": "^0.5.24",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.1.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.0"
  },
  "browserslist": [
    "> 0.2%",
    "last 2 versions",
    "Safari >= 13",
    "iOS >= 13",
    "not dead"
  ]
}
